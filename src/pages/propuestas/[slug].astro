---
import { ruta } from '../../lib/rutas';
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Rail from '../../components/Rail.astro';
import Icono from '../../components/Icono.astro';
import BotonCompartir from '../../components/BotonCompartir.astro';
import { ejePorId } from '../../data/ejes';

export const getStaticPaths = (async () => {
  const propuestas = (await getCollection('propuestas')).sort((a, b) => a.data.orden - b.data.orden);
  return propuestas.map((propuesta, i) => ({
    params: { slug: propuesta.id },
    props: { propuesta, anterior: propuestas[i - 1], siguiente: propuestas[i + 1] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  propuesta: CollectionEntry<'propuestas'>;
  anterior?: CollectionEntry<'propuestas'>;
  siguiente?: CollectionEntry<'propuestas'>;
}

const { propuesta, anterior, siguiente } = Astro.props;
const { titulo, resumen, eje, pasos, plazo } = propuesta.data;
const datosEje = ejePorId[eje];
const { Content } = await render(propuesta);
const vecinas = [
  { entrada: anterior, rotulo: 'Anterior', rel: 'prev' },
  { entrada: siguiente, rotulo: 'Siguiente', rel: 'next' },
] as const;
---

<Base titulo={`${titulo} · Merge sin conflictos`} descripcion={resumen}>
  <div class="mx-auto max-w-6xl px-4 md:px-8">
    <div class="historial pb-16 md:pb-24">
      <Rail activo={eje} />

      <a
        href={ruta('/#propuestas')}
        class="group mt-4 inline-flex min-h-11 items-center gap-2 font-bold text-enlace underline decoration-transparent hover:decoration-current"
      >
        <Icono nombre="izquierda" class="transition-transform duration-200 ease-out group-hover:-translate-x-0.5" />
        Todas las propuestas
      </a>

      <article class="relative mt-8 md:mt-12" style={`--x: var(--x-${eje}); --c: ${datosEje.color}`}>
        <span class="nodo top-[calc(1.35rem-var(--r-nodo))] bg-(--c) md:top-[calc(2.2rem-var(--r-nodo))]" aria-hidden="true"></span>
        <h1 class="max-w-[22ch] text-[clamp(2rem,8vw,3.75rem)] leading-[1.02] font-extrabold tracking-[-0.025em]">
          <span class="titulo-eje" data-eje={eje}>{titulo}</span>
        </h1>
        <p class="mt-4 flex items-center gap-2 font-bold">
          <span class="inline-block size-2.5 rounded-full bg-(--c)" aria-hidden="true"></span>
          Eje: {datosEje.nombre}
        </p>
        <p class="mt-5 max-w-[48ch] text-xl leading-snug text-texto-suave md:text-2xl">{resumen}</p>

        <!-- Qué (resumen) → por qué (cuerpo del Markdown) → cómo (pasos) → cuándo (plazo). -->
        <section class="mt-10 max-w-[65ch]" aria-labelledby="titulo-por-que">
          <h2 id="titulo-por-que" class="text-2xl font-extrabold">Por qué lo proponemos</h2>
          <div class="cuerpo mt-4 space-y-4 text-lg">
            <Content />
          </div>
        </section>

        {
          pasos && pasos.length > 0 && (
            <section class="mt-10 max-w-[65ch]" aria-labelledby="titulo-pasos">
              <h2 id="titulo-pasos" class="text-2xl font-extrabold">
                Cómo lo vamos a lograr
              </h2>
              <ol class="mt-4 list-decimal space-y-2 pl-6 text-lg marker:font-bold">
                {pasos.map((paso) => <li>{paso}</li>)}
              </ol>
            </section>
          )
        }

        {
          plazo && (
            <p class="mt-8 text-lg">
              <strong>Plazo:</strong>{' '}
              {/* Los semestres (2027-A) no se parten al cambiar de línea. */}
              {plazo.split(/(\d{4}-[AB])/).map((parte, i) => (i % 2 ? <span class="whitespace-nowrap">{parte}</span> : parte))}
            </p>
          )
        }

        <div class="mt-10">
          <BotonCompartir
            texto={`Propuesta de Merge sin conflictos: ${titulo}.`}
            ruta={ruta(`/propuestas/${propuesta.id}`)}
            etiqueta="Compartir propuesta"
          />
        </div>
      </article>

      <nav aria-label="Otras propuestas" class="mt-14 grid max-w-3xl gap-3 sm:grid-cols-2">
        {
          vecinas.map(({ entrada, rotulo, rel }) =>
            entrada ? (
              <a
                href={ruta(`/propuestas/${entrada.id}`)}
                rel={rel}
                class:list={[
                  'group flex min-h-11 flex-col rounded-2xl border-2 border-borde p-4 transition-colors hover:border-texto',
                  rel === 'next' && 'sm:col-start-2 sm:text-right',
                ]}
              >
                <span class:list={['flex items-center gap-2 text-sm text-texto-suave', rel === 'next' && 'sm:justify-end']}>
                  {rel === 'prev' && <Icono nombre="izquierda" class="size-4" />}
                  {rotulo}
                  {rel === 'next' && <Icono nombre="derecha" class="size-4" />}
                </span>
                <span class="mt-1 font-titular text-lg leading-snug font-bold">{entrada.data.titulo}</span>
                <span class:list={['mt-2 flex items-center gap-2 text-sm', rel === 'next' && 'sm:justify-end']}>
                  <span
                    class="inline-block size-2.5 rounded-full"
                    style={`background:${ejePorId[entrada.data.eje].color}`}
                    aria-hidden="true"
                  />
                  {ejePorId[entrada.data.eje].nombre}
                </span>
              </a>
            ) : null,
          )
        }
      </nav>
    </div>
  </div>
</Base>

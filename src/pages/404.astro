---
// Página para enlaces rotos. GitHub Pages sirve 404.html en cualquier ruta que no exista.
import { ruta } from '../lib/rutas';
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
---

<Base
  titulo="Página no encontrada · Merge sin conflictos"
  indexar={false}
  descripcion="Esta página no existe. Mira las propuestas de Merge sin conflictos para el Centro de Estudiantes de la EPCC."
>
  <section class="mx-auto flex max-w-3xl flex-col items-start px-4 py-20 md:px-8 md:py-32" aria-labelledby="titulo-404">
    <p class="text-sm font-bold tracking-[0.08em] text-enlace uppercase">Error 404 · rama no encontrada</p>
    <h1 id="titulo-404" class="mt-3 text-[clamp(2.5rem,10vw,4.5rem)] leading-[1.02] font-extrabold tracking-[-0.03em]">
      Esta página no existe.
    </h1>
    <p class="mt-5 max-w-[44ch] text-lg text-texto-suave">
      Puede que el enlace esté incompleto o que la página haya cambiado de nombre. Las propuestas siguen aquí.
    </p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a
        href={ruta('/#propuestas')}
        class="inline-flex min-h-12 items-center gap-2 rounded-full bg-verde px-6 font-bold text-negro transition-[filter] hover:brightness-95"
      >
        Ver propuestas
        <Icono nombre="derecha" />
      </a>
      <a
        href={ruta('/')}
        class="inline-flex min-h-12 items-center rounded-full border-2 border-texto px-6 font-bold transition-colors hover:bg-texto hover:text-fondo"
      >
        Ir al inicio
      </a>
    </div>
  </section>
</Base>

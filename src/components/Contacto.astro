---
import { ruta } from '../lib/rutas';
import BotonCompartir from './BotonCompartir.astro';
---

<section id="contacto" aria-labelledby="titulo-contacto" class="fondo-contacto scroll-mt-20 py-16 text-blanco md:py-24">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 md:grid-cols-[1.4fr_1fr] md:gap-16 md:px-8">
    <div>
      <p class="font-titular text-[clamp(2.25rem,9vw,4.5rem)] leading-[0.95] font-extrabold tracking-[-0.03em] text-balance">
        Vota por Merge sin&nbsp;conflictos.
      </p>
      <!-- Eslogan oficial de la lista. -->
      <p class="mt-4 font-titular text-xl font-bold md:text-2xl">Unimos ideas, construimos cambios.</p>
      <p class="mt-5 max-w-[40ch] text-lg">
        Elecciones del Centro de Estudiantes de Ciencia de la Computación.
      </p>
      <!-- Fechas aún no anunciadas: se reemplaza «por confirmar» cuando se conozcan. -->
      <dl class="mt-6 grid max-w-md gap-3">
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-l-4 border-verde pl-4">
          <dt class="font-bold">Elección</dt>
          <dd class="text-blanco/85">Fecha por confirmar</dd>
        </div>
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-l-4 border-verde pl-4">
          <dt class="font-bold">Debate virtual</dt>
          <dd class="text-blanco/85">Fecha por confirmar</dd>
        </div>
      </dl>
      <div class="mt-8">
        <p class="mb-4 max-w-[36ch]">¿Conoces a alguien de la Escuela que debería verlo?</p>
        <BotonCompartir
          tono="sobre-azul"
          texto="Mira las propuestas de Merge sin conflictos para el Centro de Estudiantes de la EPCC:"
          ruta={ruta('/')}
        />
      </div>
    </div>

    <div class="md:border-l-2 md:border-blanco/30 md:pl-10">
      <h2 id="titulo-contacto" class="text-2xl font-extrabold md:text-3xl">Contacto</h2>
      <p class="mt-5">Escríbenos a</p>
      <a
        href="mailto:nlazop@unsa.edu.pe"
        class="mt-1 inline-flex min-h-11 items-center text-lg font-bold break-all underline decoration-verde decoration-2 underline-offset-4 hover:decoration-blanco md:text-xl"
        >nlazop@unsa.edu.pe</a
      >
    </div>
  </div>
</section>

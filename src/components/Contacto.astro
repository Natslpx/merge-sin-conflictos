---
import Pendiente from './Pendiente.astro';
import BotonCompartir from './BotonCompartir.astro';
---

<section id="contacto" aria-labelledby="titulo-contacto" class="scroll-mt-4 bg-azul py-16 text-blanco md:py-24">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 md:grid-cols-[1.4fr_1fr] md:gap-16 md:px-8">
    <div>
      <p class="font-titular text-[clamp(2.25rem,9vw,4.5rem)] leading-[0.95] font-extrabold tracking-[-0.03em] text-balance">
        Vota por Merge sin&nbsp;conflictos.
      </p>
      <p class="mt-5 max-w-[40ch] text-lg">
        Elecciones del Centro de Estudiantes de Ciencia de la Computación.
      </p>
      <p class="mt-3"><Pendiente>fecha de la elección</Pendiente></p>
      <div class="mt-8">
        <p class="mb-4 max-w-[36ch]">¿Conoces a alguien de la Escuela que debería verlo?</p>
        <BotonCompartir
          tono="sobre-azul"
          texto="Mira las propuestas de Merge sin conflictos para el Centro de Estudiantes de la EPCC:"
          ruta="/"
        />
      </div>
    </div>

    <div class="md:border-l-2 md:border-blanco/30 md:pl-10">
      <h2 id="titulo-contacto" class="text-2xl font-extrabold md:text-3xl">Contacto</h2>
      <ul class="mt-5 space-y-3">
        <li><Pendiente>redes sociales de la lista</Pendiente></li>
        <li><Pendiente>correo de la lista</Pendiente></li>
      </ul>
    </div>
  </div>
</section>

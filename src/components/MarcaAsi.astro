---
import { Image } from 'astro:assets';
import logo from '../assets/campana/logo.png';
---

<!-- Sección sin enlace en el header: cómo marcar en la cédula. La X se dibuja al aparecer en pantalla. -->
<section id="marca-asi" aria-labelledby="titulo-marca" class="scroll-mt-20 py-16 md:py-24" data-marca>
  <div class="mx-auto flex max-w-6xl flex-col items-center px-4 text-center md:px-8">
    <h2 id="titulo-marca" class="text-4xl leading-none font-extrabold tracking-[-0.02em] md:text-6xl">
      <span class="resaltado">Marca así</span>
    </h2>
    <p class="mt-4 max-w-[36ch] text-lg text-texto-suave md:text-xl">
      Busca el número 3 y nuestro logo en la cédula, y márcalo con una X.
    </p>

    <figure class="cedula mt-10 w-full max-w-2xl rounded-[2rem] bg-tarjeta p-5 ring-[3px] ring-texto min-[25rem]:p-6 md:mt-14 md:p-10">
      <div class="flex items-center gap-4 md:gap-10">
        <span
          class="grid size-16 shrink-0 place-items-center rounded-full bg-verde font-titular text-5xl font-extrabold text-negro min-[25rem]:size-20 min-[25rem]:text-6xl md:size-36 md:text-8xl"
          aria-hidden="true">3</span
        >
        <div class="relative grid flex-1 place-items-center rounded-3xl border-[3px] border-dashed border-borde p-3 md:p-6">
          <Image src={logo} alt="" width={720} class="logo-marca h-auto w-full max-w-80" />
          <svg class="equis absolute inset-0 m-auto size-[88%]" viewBox="0 0 100 100" fill="none" aria-hidden="true">
            <path d="M14 12 Q48 52 87 89" pathLength="1" />
            <path d="M86 13 Q50 46 13 88" pathLength="1" />
          </svg>
        </div>
      </div>
      <figcaption class="mt-5 font-titular text-xl font-extrabold text-balance min-[25rem]:text-2xl md:mt-8 md:text-4xl">
        Lista 3 · Merge sin conflictos
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .cedula {
    box-shadow: 0 18px 40px -22px rgb(3 77 161 / 0.55);
  }
  .equis path {
    stroke: var(--color-texto);
    stroke-width: 9;
    stroke-linecap: round;
  }

  /* La X se traza como con lapicero: primero un trazo y luego el otro. */
  @media (prefers-reduced-motion: no-preference) {
    [data-marca].js .equis path {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      opacity: 0;
    }
    [data-marca].js .logo-marca {
      transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    [data-marca].visible .equis path:nth-child(1) {
      animation: trazar 0.45s cubic-bezier(0.65, 0, 0.35, 1) 0.35s forwards;
    }
    [data-marca].visible .equis path:nth-child(2) {
      animation: trazar 0.45s cubic-bezier(0.65, 0, 0.35, 1) 0.9s forwards;
    }
    [data-marca].visible .logo-marca {
      animation: sello 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) 1.35s both;
    }
    @keyframes trazar {
      from {
        opacity: 1;
      }
      to {
        opacity: 1;
        stroke-dashoffset: 0;
      }
    }
    @keyframes sello {
      50% {
        transform: scale(0.94);
      }
      to {
        transform: none;
      }
    }
  }
</style>

<script>
  const seccion = document.querySelector<HTMLElement>('[data-marca]');
  if (seccion && 'IntersectionObserver' in window) {
    seccion.classList.add('js');
    // Se vuelve a dibujar cada vez que la cédula entra en pantalla.
    new IntersectionObserver(
      ([entrada]) => {
        if (!entrada) return;
        if (entrada.intersectionRatio >= 0.5) seccion.classList.add('visible');
        else if (!entrada.isIntersecting) seccion.classList.remove('visible');
      },
      { threshold: [0, 0.5] },
    ).observe(seccion.querySelector('.cedula')!);
  }
</script>

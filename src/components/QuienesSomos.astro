---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Pendiente from './Pendiente.astro';
import { iniciales } from '../lib/texto';

const equipo = (await getCollection('equipo')).sort((a, b) => a.data.orden - b.data.orden);
const integrantes = await Promise.all(
  equipo.map(async (entrada) => ({ entrada, Contenido: (await render(entrada)).Content })),
);
---

<section id="quienes-somos" aria-labelledby="titulo-quienes" class="scroll-mt-4 bg-superficie py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4 md:px-8">
    <h2 id="titulo-quienes" class="text-4xl leading-none font-extrabold tracking-[-0.02em] md:text-5xl">Quiénes somos</h2>

    <div class="mt-10 space-y-14 md:mt-14">
      {
        integrantes.map(({ entrada, Contenido }) => {
          const d = entrada.data;
          const esPresidenta = d.cargo === 'Presidenta';
          return (
            <article
              class:list={[
                'grid gap-5 md:gap-x-10',
                esPresidenta ? 'md:grid-cols-[12rem_1fr]' : 'md:grid-cols-[12rem_1fr] md:items-start',
              ]}
            >
              <div class="md:justify-self-end">
                {d.foto ? (
                  <Image
                    src={d.foto}
                    alt={`Foto de ${d.nombre_corto}`}
                    width={esPresidenta ? 192 : 128}
                    class:list={['rounded-full object-cover', esPresidenta ? 'size-32 md:size-48' : 'size-24 md:size-32']}
                  />
                ) : (
                  <div
                    class:list={[
                      'grid place-items-center rounded-full font-titular font-extrabold tracking-[-0.02em]',
                      esPresidenta
                        ? 'size-32 bg-azul text-5xl text-blanco md:size-48 md:text-7xl'
                        : 'size-24 bg-verde text-3xl text-negro md:size-32 md:text-5xl',
                    ]}
                    aria-hidden="true"
                  >
                    {iniciales(d.nombre_corto)}
                  </div>
                )}
              </div>
              <div class="max-w-[62ch]">
                <h3 class:list={['leading-tight font-extrabold', esPresidenta ? 'text-3xl md:text-4xl' : 'text-2xl md:text-3xl']}>
                  {d.nombre_corto}
                  {d.apodo && <span class="font-semibold text-texto-suave"> · «{d.apodo}»</span>}
                </h3>
                <p class="mt-1 text-lg font-bold">
                  {d.cargo}
                  {d.ciclo ? <span class="font-normal text-texto-suave"> · {d.ciclo}</span> : null}
                </p>
                {(!d.ciclo || d.provisional) && (
                  <p class="mt-3 flex flex-wrap gap-2">
                    {!d.ciclo && <Pendiente>ciclo</Pendiente>}
                    {d.provisional && <Pendiente>descripción definitiva (la actual es provisional)</Pendiente>}
                  </p>
                )}
                <div class:list={['presentacion mt-4 space-y-4', esPresidenta && 'md:text-lg']}>
                  <Contenido />
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .presentacion :global(ul) {
    display: grid;
    gap: 0.625rem;
    padding: 0;
    list-style: none;
  }
  .presentacion :global(li) {
    position: relative;
    padding-left: 1.75rem;
  }
  /* Cada logro como un commit: un nodo en anillo. */
  .presentacion :global(li)::before {
    content: '';
    position: absolute;
    left: 0.125rem;
    top: 0.4em;
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 50%;
    border: 3px solid var(--color-eje-academico);
    background: var(--color-fondo);
  }
</style>

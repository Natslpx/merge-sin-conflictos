---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Pendiente from './Pendiente.astro';
import { iniciales } from '../lib/texto';

const equipo = (await getCollection('equipo')).sort((a, b) => a.data.orden - b.data.orden);
const integrantes = await Promise.all(
  equipo.map(async (entrada) => ({ entrada, Contenido: (await render(entrada)).Content })),
);
---

<section id="quienes-somos" aria-labelledby="titulo-quienes" class="scroll-mt-20 py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4 md:px-8">
    <h2 id="titulo-quienes" class="text-center text-4xl leading-none font-extrabold tracking-[-0.02em] md:text-5xl"><span class="resaltado">Quiénes somos</span></h2>

    <div class="mx-auto mt-10 max-w-3xl space-y-8 md:mt-14 md:space-y-12">
      {
        integrantes.map(({ entrada, Contenido }) => {
          const d = entrada.data;
          const esPresidenta = d.cargo === 'Presidenta';
          return (
            <article class="tarjeta-perfil flex flex-col gap-6 rounded-[2rem] bg-tarjeta/45 p-6 ring-1 ring-blanco/70 backdrop-blur-md md:gap-8 md:p-12">
              <div class="self-center" style={`--c: ${esPresidenta ? 'var(--color-eje-academico)' : 'var(--color-verde)'}`}>
                {d.foto ? (
                  <Image
                    src={d.foto}
                    alt={`Foto de ${d.nombre_corto}`}
                    width={576}
                    class="size-52 rounded-full bg-tarjeta object-cover object-[50%_18%] ring-4 ring-(--c) ring-offset-4 ring-offset-transparent shadow-[0_16px_36px_-14px_rgb(3_77_161/0.5)] md:size-72"
                  />
                ) : (
                  <div
                    class:list={[
                      'grid size-52 place-items-center rounded-full font-titular text-7xl font-extrabold tracking-[-0.02em] ring-4 ring-(--c) ring-offset-4 ring-offset-tarjeta shadow-[0_16px_36px_-14px_rgb(3_77_161/0.5)] md:size-72 md:text-8xl',
                      esPresidenta ? 'bg-azul text-blanco' : 'bg-verde text-negro',
                    ]}
                    aria-hidden="true"
                  >
                    {iniciales(d.nombre_corto)}
                  </div>
                )}
              </div>
              <div class="max-w-[62ch]">
                <h3 class="text-3xl leading-tight font-extrabold md:text-4xl">
                  {d.nombre_corto}
                  {d.apodo && <span class="font-semibold text-texto-suave"> · «{d.apodo}»</span>}
                </h3>
                <p class="mt-1 text-lg font-bold">
                  {d.cargo}
                  {d.ciclo ? <span class="font-normal text-texto-suave"> · {d.ciclo}</span> : null}
                </p>
                {(!d.ciclo || d.provisional) && (
                  <p class="mt-3 flex flex-wrap gap-2">
                    {!d.ciclo && <Pendiente>ciclo</Pendiente>}
                    {d.provisional && <Pendiente>descripción definitiva (la actual es provisional)</Pendiente>}
                  </p>
                )}
                <div class="presentacion mt-4 space-y-4 md:text-lg">
                  <Contenido />
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .tarjeta-perfil {
    box-shadow:
      0 1px 2px rgb(3 77 161 / 0.06),
      0 24px 48px -28px rgb(3 77 161 / 0.45);
  }
  .presentacion :global(ul) {
    display: grid;
    gap: 0.625rem;
    padding: 0;
    list-style: none;
  }
  .presentacion :global(li) {
    position: relative;
    padding-left: 1.75rem;
  }
  /* Cada logro como un commit: un nodo en anillo. */
  .presentacion :global(li)::before {
    content: '';
    position: absolute;
    left: 0.125rem;
    top: 0.4em;
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 50%;
    border: 3px solid var(--color-eje-academico);
    background: var(--color-fondo);
  }
</style>

---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Icono from './Icono.astro';
import logo from '../assets/campana/logo.jpg';

// La fórmula sale de src/content/equipo (nombre completo y cargo).
const equipo = (await getCollection('equipo')).sort((a, b) => a.data.orden - b.data.orden);
---

<section
  id="inicio"
  aria-labelledby="titulo-inicio"
  class="mx-auto flex min-h-[calc(100svh-3.5rem)] max-w-6xl flex-col items-center justify-center px-4 py-8 text-center md:px-8 md:py-12"
>
  <h1
    id="titulo-inicio"
    class="text-[clamp(2.6rem,11.5vw,5.5rem)] leading-[0.95] font-extrabold tracking-[-0.03em] [font-variation-settings:'opsz'_96]"
  >
    <span class="block">Merge sin conflictos</span>
    <span class="mt-1 flex items-center justify-center gap-[0.22em] md:mt-2">
      Somos lista
      <span
        class="inline-grid size-[1.15em] place-items-center rounded-full bg-verde leading-none text-negro"
        aria-hidden="true">3</span
      ><span class="sr-only">3</span>
    </span>
  </h1>

  <div class="logo-entrada mt-5 md:mt-6">
    <Image
      src={logo}
      alt="Logo de Merge sin conflictos: un personaje naranja con sombrero arequipeño que levanta el pulgar."
      width={480}
      height={480}
      loading="eager"
      fetchpriority="high"
      class="size-52 rounded-[2rem] bg-blanco min-[25rem]:size-60 md:size-[min(16rem,30svh)]"
    />
  </div>

  <ul class="mt-5 grid w-full max-w-lg grid-cols-2 gap-3 md:mt-6 md:gap-6">
    {
      equipo.map((integrante) => (
        <li class="grid grid-rows-[1fr_auto] justify-items-center">
          <span class="flex h-full min-h-[4.5rem] w-full items-center justify-center rounded-[1.75rem] bg-superficie px-3 py-3 font-titular text-base leading-tight font-bold text-balance ring-2 ring-borde min-[25rem]:text-lg md:text-xl">
            {integrante.data.nombre}
          </span>
          <span class="mt-2 text-sm font-bold md:text-base">{integrante.data.cargo}</span>
        </li>
      ))
    }
  </ul>

  <a
    href="#propuestas"
    class="group mt-7 inline-flex min-h-14 items-center gap-2 rounded-full bg-verde px-8 font-titular text-xl font-extrabold text-negro transition-[filter,transform] duration-200 ease-out hover:-translate-y-0.5 hover:brightness-95 md:mt-7 md:text-2xl"
  >
    Ver propuestas
    <Icono nombre="abajo" class="size-6 transition-transform duration-200 ease-out group-hover:translate-y-0.5" />
  </a>
</section>

<style>
  /* Primera impresión: el logo entra con un pequeño rebote al abrir el enlace. */
  @media (prefers-reduced-motion: no-preference) {
    .logo-entrada {
      animation: entrada 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) both;
      animation-delay: 0.1s;
    }
    @keyframes entrada {
      from {
        opacity: 0;
        transform: scale(0.8) rotate(-4deg);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>

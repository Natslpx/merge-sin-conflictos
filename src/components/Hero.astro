---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Icono from './Icono.astro';
import logo from '../assets/campana/logo.png';

// La fórmula sale de src/content/equipo (nombre completo y cargo).
const equipo = (await getCollection('equipo')).sort((a, b) => a.data.orden - b.data.orden);
// Cada candidato es una rama que sale de main (el logo): azul para la presidenta, verde para el vice.
// «Natalie Marleny Lazo Paxi» → nombres en una línea y apellidos en la siguiente.
const partirNombre = (nombre: string) => {
  const p = nombre.trim().split(/\s+/);
  const mitad = Math.ceil(p.length / 2);
  return [p.slice(0, mitad).join(' '), p.slice(mitad).join(' ')];
};
const colorRama = (cargo: string) => (cargo === 'Presidenta' ? 'var(--color-eje-academico)' : 'var(--color-verde)');
---

<div class="relative isolate">
  <!-- Lluvia de bits (0 y 1) detrás del inicio; se desvanece al acercarse a Propuestas. -->
  <canvas class="bits pointer-events-none absolute inset-0 -z-10 size-full" aria-hidden="true" data-bits></canvas>
  <section
    id="inicio"
    aria-labelledby="titulo-inicio"
    class="hero mx-auto flex min-h-[calc(100svh-4rem)] max-w-6xl flex-col items-center px-4 pt-6 text-center md:px-8 md:pt-8"
  >
    <span class="min-h-0 flex-1" aria-hidden="true"></span>
    <!-- Contexto: quien llega desde un enlace reenviado debe saber qué elección es. -->
    <p class="mb-2 max-w-[40ch] text-xs font-bold tracking-[0.08em] text-enlace uppercase md:mb-4 md:max-w-none md:text-sm">
      Elecciones del Centro de Estudiantes · Ciencia de la Computación UNSA
    </p>
    <h1
      id="titulo-inicio"
      class="leading-[1.02] font-extrabold tracking-[-0.03em] [font-variation-settings:'opsz'_96]"
    >
      <span class="block text-[clamp(3.1rem,14.5vw,6rem)] leading-[0.98]"><span class="resaltado">Merge sin conflictos</span></span>
      <span class="mt-4 flex items-center justify-center gap-[0.22em] text-[clamp(2.2rem,10vw,3.75rem)] md:mt-6">
        Somos lista
        <span
          class="inline-grid size-[1.15em] place-items-center rounded-full bg-verde leading-none text-negro"
          aria-hidden="true">3</span
        ><span class="sr-only">3</span>
      </span>
    </h1>

    <!-- Visión: tomada de las presentaciones de Natalie y Jhair. -->
    <p class="mt-3 max-w-[32ch] text-base leading-snug font-bold text-balance min-[25rem]:text-lg md:mt-4 md:text-xl">
      Un Centro de Estudiantes más cercano, con más oportunidades y una comunidad más unida.
    </p>

    <!-- main: el logo. De él salen las ramas. -->
    <div class="logo-entrada relative z-10 mt-4 md:mt-6">
      <Image
        src={logo}
        alt="Logo de Merge sin conflictos: un personaje naranja con sombrero arequipeño que levanta el pulgar."
        width={560}
        loading="eager"
        fetchpriority="high"
        class="logo-main h-auto w-[min(10rem,19svh)] min-[25rem]:w-[min(12rem,22svh)] md:w-[min(11rem,16svh)]"
      />
    </div>

    <svg class="ramas-hero h-10 w-full max-w-lg md:h-12" viewBox="0 0 100 40" preserveAspectRatio="none" fill="none" aria-hidden="true">
      <path d="M50 0 V40" stroke="var(--color-texto)" />
      {
        equipo.map((integrante, i) => {
          const x = i === 0 ? 25 : 75;
          return <path d={`M50 0 C50 26 ${x} 14 ${x} 40`} stroke={colorRama(integrante.data.cargo)} />;
        })
      }
    </svg>

    <ul class="relative grid w-full max-w-lg grid-cols-2 gap-4 md:gap-6">
      <span class="linea-main absolute inset-y-0 left-1/2 -translate-x-1/2" aria-hidden="true"></span>
      {
        equipo.map((integrante) => (
          <li class="relative grid grid-rows-[1fr_auto] justify-items-center" style={`--c: ${colorRama(integrante.data.cargo)}`}>
            <span class="flex h-full min-h-[4.5rem] w-full items-center justify-center rounded-[1.75rem] bg-tarjeta px-3 py-3 font-titular text-base leading-tight font-bold text-balance ring-[3px] ring-(--c) min-[25rem]:text-lg md:text-xl">
              {partirNombre(integrante.data.nombre)[0]}<br />{partirNombre(integrante.data.nombre)[1]}
            </span>
            <span class="mt-2 text-sm font-bold md:text-base">{integrante.data.cargo}</span>
          </li>
        ))
      }
    </ul>

    <span class="linea-main h-6 md:h-8" aria-hidden="true"></span>

    <a
      href="#propuestas"
      class="group relative inline-flex min-h-14 items-center gap-2 rounded-full bg-verde px-8 font-titular text-xl font-extrabold text-negro ring-4 ring-fondo transition-[filter,transform] duration-200 ease-out hover:-translate-y-0.5 hover:brightness-95 md:text-2xl"
    >
      Ver propuestas
      <Icono nombre="abajo" class="size-6 transition-transform duration-200 ease-out group-hover:translate-y-0.5" />
    </a>

    <!-- main sigue bajando hasta las propuestas. -->
    <span class="linea-main min-h-10 flex-1" aria-hidden="true"></span>
  </section>
</div>

<style>
  .hero {
    --t: 4px;
  }
  @media (min-width: 48rem) {
    .hero {
      --t: 6px;
    }
  }
  .bits {
    -webkit-mask-image: linear-gradient(to bottom, black 0%, black 40%, transparent 92%);
    mask-image: linear-gradient(to bottom, black 0%, black 40%, transparent 92%);
  }

  /* Sombra que sigue la silueta del logo (ya no tiene fondo). */
  .logo-main {
    filter: drop-shadow(0 12px 18px rgb(3 77 161 / 0.22));
  }
  .linea-main {
    display: block;
    width: var(--t);
    background: var(--color-texto);
  }
  .ramas-hero {
    overflow: visible;
  }
  .ramas-hero path {
    stroke-width: var(--t);
    vector-effect: non-scaling-stroke;
  }

  /* Primera impresión: el logo entra con un pequeño rebote al abrir el enlace. */
  @media (prefers-reduced-motion: no-preference) {
    .logo-entrada {
      animation: entrada 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) both;
      animation-delay: 0.1s;
    }
    @keyframes entrada {
      from {
        opacity: 0;
        transform: scale(0.8) rotate(-4deg);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>

<script>
  // Lluvia de bits: columnas de 0 y 1 que caen despacio, en azul y algunas en verde.
  // Se pausa fuera de pantalla o con la pestaña oculta. Con movimiento reducido queda quieta.
  const lienzo = document.querySelector<HTMLCanvasElement>('[data-bits]');
  const ctx = lienzo?.getContext('2d');

  if (lienzo && ctx) {
    const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const oscuro = window.matchMedia('(prefers-color-scheme: dark)');
    const TAM = 18; // alto de cada bit en px
    type Columna = { x: number; y: number; vel: number; largo: number; bits: string[]; verde: boolean };
    let columnas: Columna[] = [];
    let ancho = 0;
    let alto = 0;

    const bit = () => (Math.random() < 0.5 ? '0' : '1');
    const nueva = (x: number, arriba: boolean): Columna => {
      const largo = 5 + Math.floor(Math.random() * 9);
      return {
        x,
        y: arriba ? -Math.random() * alto * 0.6 : Math.random() * alto,
        vel: 28 + Math.random() * 46, // px por segundo
        largo,
        bits: Array.from({ length: largo }, bit),
        verde: Math.random() < 0.28,
      };
    };

    const medir = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      ancho = lienzo.clientWidth;
      alto = lienzo.clientHeight;
      lienzo.width = Math.round(ancho * dpr);
      lienzo.height = Math.round(alto * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.font = `700 ${TAM - 4}px ui-monospace, Consolas, monospace`;
      ctx.textAlign = 'center';
      const paso = ancho < 640 ? 26 : 30;
      columnas = [];
      for (let x = paso / 2; x < ancho; x += paso) {
        // No todas las columnas llevan bits: deja aire para que no sea una pared.
        if (Math.random() < 0.55) columnas.push(nueva(x, false));
      }
    };

    const dibujar = () => {
      ctx.clearRect(0, 0, ancho, alto);
      const fuerza = oscuro.matches ? 0.5 : 0.32;
      for (const c of columnas) {
        ctx.fillStyle = c.verde ? '#78c203' : oscuro.matches ? '#6f9fe0' : '#034da1';
        for (let i = 0; i < c.largo; i++) {
          const y = c.y - i * TAM;
          if (y < -TAM || y > alto + TAM) continue;
          // La cabeza es la más visible; la cola se apaga.
          ctx.globalAlpha = fuerza * (1 - i / c.largo) * (i === 0 ? 1.4 : 1);
          ctx.fillText(c.bits[i]!, c.x, y);
        }
      }
      ctx.globalAlpha = 1;
    };

    let anterior = 0;
    let acumulado = 0;
    let animando = false;
    let idCuadro = 0;

    const cuadro = (t: number) => {
      const dt = Math.min((t - anterior) / 1000, 0.1);
      anterior = t;
      acumulado += dt;
      for (const c of columnas) {
        c.y += c.vel * dt;
        if (c.y - c.largo * TAM > alto) Object.assign(c, nueva(c.x, true));
      }
      // Los bits cambian de valor de vez en cuando, como si se recalcularan.
      if (acumulado > 0.12) {
        acumulado = 0;
        for (const c of columnas) if (Math.random() < 0.3) c.bits[Math.floor(Math.random() * c.largo)] = bit();
      }
      dibujar();
      idCuadro = requestAnimationFrame(cuadro);
    };

    const iniciar = () => {
      if (animando || reducido) return;
      animando = true;
      anterior = performance.now();
      idCuadro = requestAnimationFrame(cuadro);
    };
    const detener = () => {
      animando = false;
      cancelAnimationFrame(idCuadro);
    };

    medir();
    dibujar();

    let visible = true;
    new IntersectionObserver(([e]) => {
      visible = Boolean(e?.isIntersecting);
      visible && !document.hidden ? iniciar() : detener();
    }).observe(lienzo);
    document.addEventListener('visibilitychange', () => (visible && !document.hidden ? iniciar() : detener()));
    new ResizeObserver(() => {
      medir();
      dibujar();
    }).observe(lienzo);
    oscuro.addEventListener('change', dibujar);
  }
</script>

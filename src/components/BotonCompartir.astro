---
import Icono from './Icono.astro';
import { enlaceWhatsApp, urlPublica } from '../lib/compartir';

interface Props {
  texto: string;
  ruta: string;
  etiqueta?: string;
  /** "sobre-azul" para usarlo dentro de una banda azul. */
  tono?: 'normal' | 'sobre-azul';
}

const { texto, ruta, etiqueta = 'Compartir por WhatsApp', tono = 'normal' } = Astro.props;
const href = enlaceWhatsApp(texto, ruta, Astro.site);
const url = urlPublica(ruta, Astro.site);
// Con el menú de compartir del celular ya no se habla de WhatsApp: el usuario elige la app.
const etiquetaNativa = etiqueta.includes('WhatsApp') ? 'Compartir' : etiqueta;
const sobreAzul = tono === 'sobre-azul';
---

<!--
  Sin JavaScript: enlace a WhatsApp. Con JavaScript: en el celular abre el menú de compartir del
  sistema (WhatsApp, Instagram, Telegram…), y se agrega «Copiar enlace».
-->
<div data-compartir data-texto={texto} data-url={url} data-etiqueta-nativa={etiquetaNativa}>
  <div class="flex flex-wrap items-center gap-3">
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      data-principal
      class:list={[
        'inline-flex min-h-12 items-center gap-2 rounded-full px-6 font-bold transition-colors',
        sobreAzul ? 'bg-blanco text-azul hover:bg-blanco/90' : 'border-2 border-texto hover:bg-texto hover:text-fondo',
      ]}
    >
      <Icono nombre="compartir" />
      <span data-etiqueta>{etiqueta}</span><span class="sr-only" data-nueva-pestana> (se abre en una pestaña nueva)</span>
    </a>
    <button
      type="button"
      hidden
      data-copiar
      class:list={[
        'inline-flex min-h-12 items-center gap-2 rounded-full px-5 font-bold underline decoration-transparent decoration-2 underline-offset-4 transition-colors hover:decoration-current',
        sobreAzul ? 'text-blanco' : 'text-enlace',
      ]}
    >
      <Icono nombre="copiar" />
      Copiar enlace
    </button>
  </div>
  <p class="sr-only" role="status" aria-live="polite" data-aviso></p>
</div>

<script>
  for (const caja of document.querySelectorAll<HTMLElement>('[data-compartir]')) {
    const principal = caja.querySelector<HTMLAnchorElement>('[data-principal]')!;
    const copiar = caja.querySelector<HTMLButtonElement>('[data-copiar]')!;
    const aviso = caja.querySelector<HTMLElement>('[data-aviso]')!;
    const texto = caja.dataset.texto ?? '';
    const url = new URL(caja.dataset.url ?? '/', location.href).href;
    const datos = { title: document.title, text: texto, url };

    // Menú de compartir del sistema: solo en pantallas táctiles (en PC suele ser incompleto).
    const tactil = window.matchMedia('(pointer: coarse)').matches;
    if (tactil && navigator.share && (!navigator.canShare || navigator.canShare(datos))) {
      caja.querySelector('[data-etiqueta]')!.textContent = caja.dataset.etiquetaNativa ?? 'Compartir';
      caja.querySelector('[data-nueva-pestana]')?.remove();
      principal.addEventListener('click', async (evento) => {
        evento.preventDefault();
        try {
          await navigator.share(datos);
        } catch {
          // El usuario cerró el menú: no se hace nada.
        }
      });
    }

    if (navigator.clipboard) {
      copiar.hidden = false;
      copiar.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(url);
          aviso.textContent = 'Enlace copiado';
        } catch {
          aviso.textContent = 'No se pudo copiar el enlace';
        }
        const etiqueta = copiar.lastChild!;
        const original = etiqueta.textContent;
        etiqueta.textContent = aviso.textContent;
        setTimeout(() => {
          etiqueta.textContent = original;
          aviso.textContent = '';
        }, 2000);
      });
    }
  }
</script>

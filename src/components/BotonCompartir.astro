---
import Pendiente from './Pendiente.astro';
import Icono from './Icono.astro';
import { enlaceWhatsApp } from '../lib/compartir';

interface Props {
  texto: string;
  ruta: string;
  etiqueta?: string;
  /** "sobre-azul" para usarlo dentro de una banda azul. */
  tono?: 'normal' | 'sobre-azul';
}

const { texto, ruta, etiqueta = 'Compartir por WhatsApp', tono = 'normal' } = Astro.props;
const { href, tieneUrl } = enlaceWhatsApp(texto, ruta, Astro.site);
---

<div>
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    class:list={[
      'inline-flex min-h-12 items-center gap-2 rounded-full px-6 font-bold transition-colors',
      tono === 'sobre-azul'
        ? 'bg-blanco text-azul hover:bg-blanco/90'
        : 'border-2 border-texto hover:bg-texto hover:text-fondo',
    ]}
  >
    <Icono nombre="compartir" />
    {etiqueta}<span class="sr-only"> (se abre en una pestaña nueva)</span>
  </a>
  {
    !tieneUrl && (
      <p class="mt-3">
        <Pendiente>URL del sitio para incluir el enlace en el mensaje</Pendiente>
      </p>
    )
  }
</div>

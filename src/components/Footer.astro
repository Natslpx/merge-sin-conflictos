---
import { Image } from 'astro:assets';
import logo from '../assets/campana/logo.png';
---

<footer>
  <div class="mx-auto flex max-w-6xl items-center gap-4 px-4 py-8 text-sm text-texto-suave md:px-8">
    <Image src={logo} alt="" width={160} class="h-auto w-20 shrink-0" />
    <div>
      <p class="font-titular text-base font-bold text-texto">Merge sin conflictos</p>
      <p class="text-texto">Unimos ideas, construimos cambios.</p>
      <p class="mt-1">Escuela Profesional de Ciencia de la Computación (EPCC)</p>
      <p>Universidad Nacional de San Agustín de Arequipa (UNSA)</p>
    </div>
  </div>
</footer>

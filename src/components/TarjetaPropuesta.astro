---
import { ruta } from '../lib/rutas';
import type { CollectionEntry } from 'astro:content';
import { ejePorId } from '../data/ejes';
import { normalizar } from '../lib/texto';
import Icono from './Icono.astro';

interface Props {
  propuesta: CollectionEntry<'propuestas'>;
}

const { propuesta } = Astro.props;
const { titulo, resumen, eje } = propuesta.data;
const datosEje = ejePorId[eje];
const textoBusqueda = normalizar(`${titulo} ${resumen} ${datosEje.nombre}`);
---

<li
  data-propuesta
  data-eje={eje}
  data-texto={textoBusqueda}
  class="commit group relative py-6 md:py-9"
  style={`--x: var(--x-${eje}); --c: ${datosEje.color}`}
>
  <span class="nodo top-[calc(1.5rem+0.9rem-var(--r-nodo))] group-hover:bg-(--c) md:top-[calc(2.25rem+1.18rem-var(--r-nodo))]" aria-hidden="true"
  ></span>
  <article class="max-w-[60ch]">
    <h3 class="text-[1.625rem] leading-[1.1] font-extrabold tracking-[-0.02em] text-balance transition-colors duration-200 group-hover:text-enlace md:text-4xl md:leading-[1.05]">
      {titulo}
    </h3>
    <p class="mt-3 max-w-[52ch] text-texto-suave md:text-lg">{resumen}</p>
    <p class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
      <span class="flex items-center gap-2 font-bold">
        <span class="inline-block size-2.5 rounded-full bg-(--c)" aria-hidden="true"></span>
        {datosEje.nombre}
      </span>
      <a
        href={ruta(`/propuestas/${propuesta.id}`)}
        class="inline-flex min-h-11 items-center gap-1 font-bold text-enlace underline decoration-transparent transition-colors group-hover:decoration-current after:absolute after:inset-0 after:content-['']"
      >
        Ver propuesta<span class="sr-only">: {titulo}</span>
        <Icono nombre="derecha" class="size-4 transition-transform duration-200 ease-out group-hover:translate-x-0.5" />
      </a>
    </p>
  </article>
</li>

<style>
  .commit:has(a:focus-visible) {
    outline: 3px solid var(--color-enlace);
    outline-offset: 4px;
    border-radius: 0.5rem;
  }
  .commit a:focus-visible {
    outline: none;
  }
</style>

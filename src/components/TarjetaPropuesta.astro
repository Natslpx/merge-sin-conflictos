---
import { ruta } from '../lib/rutas';
import type { CollectionEntry } from 'astro:content';
import { ejePorId } from '../data/ejes';
import { normalizar } from '../lib/texto';
import Icono from './Icono.astro';

interface Props {
  propuesta: CollectionEntry<'propuestas'>;
}

const { propuesta } = Astro.props;
const { titulo, resumen, eje } = propuesta.data;
const datosEje = ejePorId[eje];
// Se busca en título, resumen, eje, pasos y el «por qué» (cuerpo del Markdown).
const textoBusqueda = normalizar(
  `${titulo} ${resumen} ${datosEje.nombre} ${(propuesta.data.pasos ?? []).join(' ')} ${propuesta.body ?? ''}`,
);
---

<li
  data-propuesta
  data-eje={eje}
  data-texto={textoBusqueda}
  class="commit group relative py-5 md:py-8"
  style={`--x: var(--x-${eje}); --c: ${datosEje.color}`}
>
  <span class="nodo top-[calc(1.25rem+0.76rem-var(--r-nodo))] group-hover:bg-(--c) md:top-[calc(2rem+1.18rem-var(--r-nodo))]" aria-hidden="true"
  ></span>
  <article class="max-w-[60ch]">
    <h4 class="text-[1.375rem] leading-[1.1] font-extrabold tracking-[-0.02em] text-balance md:text-4xl md:leading-[1.05]">
      <span class="titulo-eje" data-eje={eje}>{titulo}</span>
    </h4>
    <p class="mt-2 max-w-[52ch] text-texto-suave md:text-lg">{resumen}</p>
    <!-- El eje ya lo indica el subtítulo del grupo; la tarjeta solo enlaza al detalle. -->
    <p class="mt-1 text-sm">
      <a
        href={ruta(`/propuestas/${propuesta.id}`)}
        class="inline-flex min-h-11 items-center gap-1 font-bold text-enlace underline decoration-transparent transition-colors group-hover:decoration-current after:absolute after:inset-0 after:content-['']"
      >
        Ver propuesta<span class="sr-only">: {titulo}</span>
        <Icono nombre="derecha" class="size-4 transition-transform duration-200 ease-out group-hover:translate-x-0.5" />
      </a>
    </p>
  </article>
</li>

<style>
  .commit:has(a:focus-visible) {
    outline: 3px solid var(--color-enlace);
    outline-offset: 4px;
    border-radius: 0.5rem;
  }
  .commit a:focus-visible {
    outline: none;
  }
</style>

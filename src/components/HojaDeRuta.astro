---
/**
 * Hoja de ruta de la gestión: qué empieza en cada semestre y qué se repite todos los semestres.
 * Se arma sola con `inicio` y `recurrente` de cada propuesta (src/content/propuestas/*.md).
 */
import type { CollectionEntry } from 'astro:content';
import { ruta } from '../lib/rutas';
import { ejePorId } from '../data/ejes';
import { SEMESTRES } from '../data/gestion';

interface Props {
  propuestas: CollectionEntry<'propuestas'>[];
}

const { propuestas } = Astro.props;
const conInicio = propuestas.filter((p) => p.data.inicio);
const recurrentes = propuestas.filter((p) => p.data.recurrente);
const ultimo = SEMESTRES[SEMESTRES.length - 1];
---

<section id="hoja-de-ruta" aria-labelledby="titulo-ruta" class="scroll-mt-20 py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4 md:px-8">
    <h2 id="titulo-ruta" class="text-4xl leading-none font-extrabold tracking-[-0.02em] md:text-5xl">
      <span class="resaltado">Hoja de ruta</span>
    </h2>
    <p class="mt-3 max-w-[46ch] text-lg text-texto-suave">Qué empieza en cada semestre de la gestión.</p>

    <ol class="ruta mt-10 grid gap-10 md:grid-cols-3 md:gap-8">
      {
        SEMESTRES.map((semestre) => {
          const empiezan = conInicio.filter((p) => p.data.inicio === semestre);
          return (
            <li class="semestre relative pl-8 md:pt-10 md:pl-0">
              <span class="hito" aria-hidden="true" />
              <h3 class="font-titular text-2xl font-extrabold md:text-3xl">{semestre}</h3>
              {empiezan.length > 0 && (
                <>
                  <p class="mt-2 text-sm font-bold tracking-[0.08em] text-texto-suave uppercase">
                    {empiezan.length === 1 ? 'Empieza' : `Empiezan ${empiezan.length}`}
                  </p>
                  <ul class="mt-3 space-y-1">
                    {empiezan.map((p) => (
                      <li>
                        <a
                          href={ruta(`/propuestas/${p.id}`)}
                          class="flex min-h-11 items-center gap-2.5 py-1 leading-snug underline decoration-transparent underline-offset-4 transition-colors hover:decoration-current"
                        >
                          <span
                            class="inline-block size-2.5 shrink-0 rounded-full"
                            style={`background:${ejePorId[p.data.eje].color}`}
                            aria-hidden="true"
                          />
                          {p.data.titulo}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              )}
              {semestre === ultimo && (
                <p class="mt-3 max-w-[34ch] leading-snug">
                  <strong>Cierre de la gestión:</strong> informe de lo que avanzó y lo que no, y entrega
                  documentada a la siguiente gestión.
                </p>
              )}
            </li>
          );
        })
      }
    </ol>

    {
      recurrentes.length > 0 && (
        <div class="mt-12 border-t-2 border-borde pt-8">
          <h3 class="font-titular text-xl font-extrabold md:text-2xl">Todos los semestres</h3>
          <ul class="mt-4 grid gap-x-8 gap-y-1 md:grid-cols-2">
            {recurrentes.map((p) => (
              <li>
                <a
                  href={ruta(`/propuestas/${p.id}`)}
                  class="flex min-h-11 items-center gap-2.5 py-1 leading-snug underline decoration-transparent underline-offset-4 transition-colors hover:decoration-current"
                >
                  <span
                    class="inline-block size-2.5 shrink-0 rounded-full"
                    style={`background:${ejePorId[p.data.eje].color}`}
                    aria-hidden="true"
                  />
                  {p.data.titulo}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>

<style>
  /* Línea de tiempo como la rama main: vertical en móvil, horizontal desde tablet. */
  .ruta {
    --t: 4px;
    position: relative;
  }
  .ruta::before {
    content: '';
    position: absolute;
    left: 9px;
    top: 0.75rem;
    bottom: 0;
    width: var(--t);
    border-radius: var(--t);
    background: var(--color-texto);
  }
  .hito {
    position: absolute;
    left: 0;
    top: 0.35rem;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: var(--t) solid var(--color-texto);
    background: var(--color-fondo);
  }
  .semestre:first-child .hito {
    background: var(--color-verde);
    border-color: var(--color-verde);
  }
  @media (min-width: 48rem) {
    .ruta::before {
      left: 0;
      right: 0;
      top: 9px;
      bottom: auto;
      width: auto;
      height: var(--t);
    }
    .hito {
      top: 0;
    }
  }
</style>

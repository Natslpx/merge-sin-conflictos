---
// Marca de la lista: dos ramas que hacen merge en un nodo. Decorativa (el nombre va en texto).
interface Props {
  class?: string;
}
const { class: clase } = Astro.props;
---

<svg viewBox="0 0 32 32" width="32" height="32" fill="none" aria-hidden="true" focusable="false" class={clase}>
  <path d="M8 30V20C8 14 16 14 16 9" stroke="var(--color-eje-academico)" stroke-width="4" stroke-linecap="round"></path>
  <path d="M24 30V20C24 14 16 14 16 9" stroke="var(--color-verde)" stroke-width="4" stroke-linecap="round"></path>
  <circle cx="16" cy="7" r="6" fill="var(--color-texto)"></circle>
  <circle cx="16" cy="7" r="2.4" fill="var(--color-verde)"></circle>
</svg>

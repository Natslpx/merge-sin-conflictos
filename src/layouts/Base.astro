---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import logo from '../assets/campana/logo.png';
import { ruta } from '../lib/rutas';
// Precarga de las dos fuentes (solo el subconjunto latino, el único que se descarga) para que el
// titular del inicio aparezca con su tipografía desde el primer momento.
import fuenteTitular from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-opsz-normal.woff2?url';
import fuenteTexto from '@fontsource-variable/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-wght-normal.woff2?url';

// Ícono de la pestaña y de acceso directo, generados desde el logo de la campaña.
const favicon = await getImage({ src: logo, width: 64, format: 'png' });
const iconoApple = await getImage({ src: logo, width: 180, format: 'png' });

interface Props {
  titulo: string;
  descripcion: string;
  /** false en páginas que no deben indexarse ni tener URL canónica (404). */
  indexar?: boolean;
  /** Imagen para compartir propia (ruta dentro de public/) y su texto alternativo. */
  imagen?: { ruta: string; alt: string };
}

const { titulo, descripcion, indexar = true, imagen: imagenPropia } = Astro.props;
const url = indexar && Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
// Imagen para compartir (public/og-image.png, 1200×630). Se genera con scripts/og-image/generar.mjs.
// WhatsApp y las redes necesitan la URL absoluta, que existe al compilar para GitHub Pages.
// Cada propuesta trae la suya (public/og/propuestas/<slug>.jpg); el resto usa la general.
const rutaImagen = imagenPropia?.ruta ?? '/og-image.png';
const imagen = Astro.site ? new URL(ruta(rutaImagen), Astro.site).href : ruta(rutaImagen);
const tipoImagen = rutaImagen.endsWith('.jpg') ? 'image/jpeg' : 'image/png';
const altImagen =
  imagenPropia?.alt ?? 'Merge sin conflictos, lista 3: Natalie Lazo, presidenta, y Jhair Torres, vicepresidente.';
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Siempre tema oscuro: también la barra del navegador en el celular. -->
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a131e" />
    <link rel="preload" href={fuenteTitular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fuenteTexto} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" href={favicon.src} />
    <link rel="apple-touch-icon" href={iconoApple.src} />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content="Merge sin conflictos" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    {url && <meta property="og:url" content={url} />}
    {url && <link rel="canonical" href={url} />}
    {!indexar && <meta name="robots" content="noindex" />}
    <meta property="og:image" content={imagen} />
    <meta property="og:image:type" content={tipoImagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={altImagen} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-fondo focus:px-4 focus:py-3 focus:font-bold"
    >
      Saltar al contenido
    </a>
    <Nav />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
